# Local Environment Variables Reference (NEVER commit actual API keys)

# Choice A (Recommended - Direct, Free, Fast): Direct Google Gemini API Key from Google AI Studio
# Get your API key from https://aistudio.google.com/
# Direct Gemini API is 100% free, has no credit expiry, and requires no credit card!
GEMINI_API_KEY=AIzaSy...

# Choice B (Fallback / OpenRouter): OpenRouter API Key for free tier models
# Get your API key from https://openrouter.ai
# Set this if you want to use OpenRouter instead of direct Gemini API
OPENROUTER_API_KEY=sk-or-v1-...

# Backend server port (optional, defaults to 3001)
PORT=3001
